# HTTP/3 (UDP) is switched off: phones on a VPN or home network sometimes fail to connect once a server advertises it.
{
	servers {
		protocols h1 h2
	}
}

# Home network: Caddy runs its own small certificate authority ("tls internal")
# and issues a certificate for the server's address. Each device trusts that
# authority once (see README). Nothing goes in public DNS.
# install.sh replaces __ADDRESS__ with the address you give it (an IP or a
# local name such as sift.lan).
https://__ADDRESS__ {
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
	header -Server
}

# Phones can download the authority's certificate from here (only this one
# file is served over plain http; everything else goes to https). The file is
# the public root certificate, never a key.
http://__ADDRESS__ {
	handle /sift-ca.crt {
		root * /etc/caddy
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
